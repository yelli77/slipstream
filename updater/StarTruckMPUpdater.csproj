<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>Slipstream</AssemblyName>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Geteilte Consume-once-Marker-Logik mit dem Mod (siehe StarTruckMP.Common.LaunchMarker) -
         bewusst als einzelne Datei eingebunden statt per ProjectReference auf das ganze
         common-Projekt, um keine ungenutzten Typen/Abhaengigkeiten mitzuziehen. -->
    <Compile Include="../common/LaunchMarker.cs" Link="LaunchMarker.cs" />
  </ItemGroup>

</Project>
